<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#0E0C0B</color>
    <color name="madak_ink">#0E0C0B</color>

    <!-- System splash (Android 12+ API, back-ported by core-splashscreen): black with the Madak mark,
         immediately followed by the animated Compose intro. -->
    <style name="Theme.Madak.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/madak_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Madak</item>
    </style>

    <style name="Theme.Madak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/madak_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
