<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#071426</color>
    <color name="yt_navy">#071426</color>
    <style name="Theme.YourTech.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yt_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#071426</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.YourTech</item>
    </style>
    <style name="Theme.YourTech" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yt_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
